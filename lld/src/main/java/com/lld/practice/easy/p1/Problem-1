Map<String, String> issuedBooks;

search(String query) -> List<Book>
    List<Book> result = new ArrayList();
    for(Map.Entry<String, Book> entry : bookCatalog.entrySet()):
        if(entry.getValue().title.equalsIgnoreCase(query) || entry.getValue().author.equalsIgnoreCase(query)) {
            result.add(entry.getValue());
        }
    return result;

addBook(Book book) -> void
