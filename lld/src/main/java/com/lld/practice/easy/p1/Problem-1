issueBook(String bookId, String userId) -> void
    if(bookCatalog.containsKey(bookId)):
        Book book = bookCatalog.get(bookId);
        int availableCopies = book.totalCopies - book.issuedCopies;
        if(availableCopies > 0) {
            book.issuedCopies = book.issuedCopies - 1;
            bookCatalog.put(book.id, book);
        } else {
            System.out.println("No Copies Available");
        }
